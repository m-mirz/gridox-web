{
  "name": "gridox-web",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "wasm": "wasm-pack build ../crates/gridox-wasm --target web --release --out-dir ../../web/src/wasm --out-name gridox_wasm",
    "dev": "npm run wasm && vite",
    "build": "npm run wasm && npm run licenses && vite build",
    "licenses": "node scripts/licenses.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "size": "node scripts/check-size.mjs",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "wasm-pack": "^0.15.1"
  },
  "dependencies": {
    "cytoscape": "3.33.1"
  }
}
